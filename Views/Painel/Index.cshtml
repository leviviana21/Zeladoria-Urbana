@model List<ZeladoriaUrbana.API.Models.Ocorrencia>
@{ Layout=null; ViewData["Title"]="Ocorrências • Zeladoria Inteligente"; }
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"]</title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/painel.css"></head><body class="mvc-body"><main class="mvc-shell"><header class="mvc-header"><div><a href="/">Zeladoria Inteligente</a><h1>Painel administrativo</h1><p>Olá, @User.Identity?.Name. Consulte e atualize os chamados.</p></div><form method="post" action="/painel-mvc/sair">@Html.AntiForgeryToken()<button type="submit" class="secondary">Sair</button></form></header><nav class="mvc-nav"><a href="/painel-mvc">Ocorrências</a><a href="/painel-mvc/diversidade">Inclusão e diversidade</a></nav>@if(TempData["Mensagem"]!=null){<div class="mvc-success" role="status">@TempData["Mensagem"]</div>}<form method="get" action="/painel-mvc" class="mvc-filter"><label for="situacao">Filtrar por situação</label><select name="situacao" id="situacao"><option value="">Todas</option>@foreach(var st in new[]{"Pendente","Em Andamento","Concluído"}){<option value="@st" selected="@(ViewBag.Filtro == st)">@st</option>}</select><button type="submit">Filtrar</button></form><p><strong>@Model.Count</strong> ocorrência(s) nesta visualização, limitada às 500 mais recentes.</p><div class="mvc-table-wrap"><table class="mvc-table"><thead><tr><th>Protocolo</th><th>Categoria / problema</th><th>Endereço / contato</th><th>Situação e ações</th></tr></thead><tbody>@foreach(var o in Model){<tr><td>#@o.Id<br><small>@o.DataCriacao.ToString("dd/MM/yyyy HH:mm")</small></td><td><strong>@o.Categoria?.Nome</strong><p>@o.Descricao</p></td><td>@o.Endereco<br><small>@o.ContatoNome</small><br><small>@o.ContatoEmail</small></td><td><form method="post" action="/painel-mvc/status/@o.Id" class="mvc-action">@Html.AntiForgeryToken()<select name="situacao" aria-label="Situação da ocorrência @o.Id">@foreach(var st in new[]{"Pendente","Em Andamento","Concluído"}){<option value="@st" selected="@(o.Situacao == st)">@st</option>}</select><button type="submit">Salvar</button></form>@if(User.IsInRole("Administrador")){<form method="post" action="/painel-mvc/excluir/@o.Id" onsubmit="return confirm('Excluir esta ocorrência?');">@Html.AntiForgeryToken()<button type="submit" class="danger">Excluir</button></form>}</td></tr>}@if(Model.Count==0){<tr><td colspan="4">Nenhuma ocorrência encontrada.</td></tr>}</tbody></table></div></main></body></html>